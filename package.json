{
  "name": "dsh-edit-diff",
  "version": "1.0.1",
  "description": "Follow the agent's edits in DeepSeek Harness: open the changed file in dsh's native preview (syntax highlighting and Markdown intact) and show a side-by-side diff tab with per-line and syntax highlighting, without ever replacing the built-in renderers.",
  "icon": "./icon.svg",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "cordis",
    "diff",
    "side-by-side",
    "follow-along",
    "syntax-highlighting",
    "sidebar",
    "coding-agent"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Althrone/dsh-edit-diff.git"
  },
  "homepage": "https://github.com/Althrone/dsh-edit-diff#readme",
  "bugs": {
    "url": "https://github.com/Althrone/dsh-edit-diff/issues"
  },
  "scripts": {
    "test": "node test/run.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-api-workspace-files",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
